{
  "name": "ds2api",
  "version": "1.0.1",
  "description": "Universal DeepSeek-to-OpenAI SDK (ported from CJackHwang/ds2api) for Node.js, Bun, and Cloudflare Workers with full OpenAI SDK method compatibility and native pure-JS PoW (DeepSeekHashV1).",
  "keywords": [
    "deepseek",
    "ds2api",
    "openai",
    "openai-sdk",
    "cloudflare-workers",
    "bun",
    "nodejs",
    "llm",
    "chat-completions",
    "responses-api",
    "deepseek-hash-v1"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nctuanit/ds2api.git"
  },
  "homepage": "https://github.com/nctuanit/ds2api#readme",
  "bugs": {
    "url": "https://github.com/nctuanit/ds2api/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "worker": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "bun": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./pow": {
      "import": {
        "types": "./dist/pow/keccak.d.mts",
        "default": "./dist/pow/keccak.mjs"
      },
      "require": {
        "types": "./dist/pow/keccak.d.ts",
        "default": "./dist/pow/keccak.cjs"
      },
      "types": "./dist/pow/keccak.d.ts",
      "default": "./dist/pow/keccak.mjs"
    },
    "./types": {
      "import": {
        "types": "./dist/@types/index.d.mts",
        "default": "./dist/@types/index.mjs"
      },
      "require": {
        "types": "./dist/@types/index.d.ts",
        "default": "./dist/@types/index.cjs"
      },
      "types": "./dist/@types/index.d.ts",
      "default": "./dist/@types/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:bun": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ts-pattern": "^5.9.2"
  }
}
